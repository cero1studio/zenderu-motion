# Copiar a .env (ignorado por git) y completar. Nunca commitear valores reales.

# Google AI Studio (Gemini Omni Flash video + Nano Banana imágenes), facturación prepaga.
# En el ComfyUI de Railway ya existe como variable del servicio.
GOOGLE_API_KEY=

# comfy.org: créditos para nodos "partner" de ComfyUI (Kling Motion Control, Runway, etc.).
# creative/comfyui/client.py lo manda en extra_data si está definido.
COMFY_ORG_API_KEY=

# Runway Dev API (Act-Two, 5 créditos/s). Billetera separada del plan web.
RUNWAYML_API_SECRET=

# Kling API directa (https://api-singapore.klingai.com), opcional.
KLING_API_KEY=
